{
  "id": "operator-tools",
  "name": "Operator Tools",
  "description": "Exposes the Operator capability adapters (Beeper messaging and friends) as agent tools, calling the on-device agent bridge over pinned loopback TLS.",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "airbnb",
      "alltrails",
      "american",
      "applemusic",
      "asana",
      "audible",
      "booking",
      "cashapp",
      "chatgpt",
      "chipotle",
      "chromecast",
      "citymapper",
      "claude",
      "creditkarma",
      "delta",
      "discord",
      "doordash",
      "dropbox",
      "duolingo",
      "ebay",
      "evernote",
      "expedia",
      "facebook",
      "fitbit",
      "goodreads",
      "googledocs",
      "googlekeep",
      "googlemaps",
      "googlephotos",
      "googlesheets",
      "googleslides",
      "grok",
      "grubhub",
      "instagram",
      "kayak",
      "kindle",
      "linkedin",
      "lyft",
      "maps",
      "messages",
      "messenger",
      "mstodo",
      "netflix",
      "nike",
      "notification_reply",
      "opentable",
      "pandora",
      "pinterest",
      "pocketcasts",
      "priceline",
      "resy",
      "sephora",
      "shazam",
      "signal",
      "soundcloud",
      "southwest",
      "spotify",
      "starbucks",
      "stubhub",
      "target",
      "taskrabbit",
      "teams",
      "threads",
      "thumbtack",
      "tiktok",
      "trello",
      "tripadvisor",
      "turbotax",
      "uber",
      "ubereats",
      "united",
      "venmo",
      "viator",
      "walmart",
      "wayfair",
      "whatsapp",
      "youtube",
      "youtubemusic",
      "zelle"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "bridgeUrl",
      "tokenPath",
      "certPath"
    ],
    "properties": {
      "bridgeUrl": {
        "type": "string",
        "description": "Base URL of the agent bridge, e.g. https://127.0.0.1:9443. Loopback only."
      },
      "tokenPath": {
        "type": "string",
        "description": "Path to the bearer token file the phone runtime minted (never the token value itself)."
      },
      "certPath": {
        "type": "string",
        "description": "Path to the runtime's exported TLS certificate PEM; the plugin pins this exact certificate."
      }
    }
  }
}
