{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-launcher.local/schema/action.schema.json",
  "title": "Codex Launcher action body",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "kind", "taskId", "text"],
      "properties": {
        "actionId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["start_turn", "steer_turn"] },
        "taskId": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1, "maxLength": 131072, "pattern": "\\S" },
        "attachmentIds": { "type": "array", "uniqueItems": true, "maxItems": 16, "items": { "$ref": "#/$defs/id" } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "kind", "taskId"],
      "properties": {
        "actionId": { "$ref": "#/$defs/id" },
        "kind": { "const": "interrupt_turn" },
        "taskId": { "$ref": "#/$defs/id" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "kind", "taskId", "requestId", "requestKind", "decision"],
      "properties": {
        "actionId": { "$ref": "#/$defs/id" },
        "kind": { "const": "approval" },
        "taskId": { "$ref": "#/$defs/id" },
        "requestId": { "$ref": "#/$defs/id" },
        "requestKind": { "enum": ["command", "file", "permissions", "mcp_elicitation"] },
        "decision": { "enum": ["accept", "accept_for_session", "decline", "cancel"] }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "kind", "taskId", "requestId", "answers"],
      "properties": {
        "actionId": { "$ref": "#/$defs/id" },
        "kind": { "const": "question_response" },
        "taskId": { "$ref": "#/$defs/id" },
        "requestId": { "$ref": "#/$defs/id" },
        "answers": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 131072 } }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "kind", "projectId"],
      "properties": {
        "actionId": { "$ref": "#/$defs/id" },
        "kind": { "const": "set_project" },
        "projectId": { "$ref": "#/$defs/projectId" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "kind", "projectId", "text", "modelId", "reasoningId", "permissionModeId"],
      "properties": {
        "actionId": { "$ref": "#/$defs/id" },
        "kind": { "const": "start_turn" },
        "projectId": { "$ref": "#/$defs/projectId" },
        "text": { "type": "string", "minLength": 1, "maxLength": 131072, "pattern": "\\S" },
        "modelId": { "$ref": "#/$defs/id" },
        "reasoningId": { "$ref": "#/$defs/id" },
        "permissionModeId": { "$ref": "#/$defs/id" },
        "attachmentIds": { "type": "array", "uniqueItems": true, "maxItems": 16, "items": { "$ref": "#/$defs/id" } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "kind", "targetActionId"],
      "properties": {
        "actionId": { "$ref": "#/$defs/id" },
        "kind": { "const": "dismiss_unknown_control" },
        "taskId": { "$ref": "#/$defs/id" },
        "targetActionId": { "$ref": "#/$defs/id" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "kind", "taskId", "title"],
      "properties": {
        "actionId": { "$ref": "#/$defs/id" },
        "kind": { "const": "rename_task" },
        "taskId": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!\\s*$)(?!.*[\\u0000-\\u001F\\u007F-\\u009F])[\\s\\S]+$" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "kind", "taskId"],
      "properties": {
        "actionId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["archive_task", "fork_task"] },
        "taskId": { "$ref": "#/$defs/id" }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!.*[\\r\\n])[A-Za-z0-9._:-]+$" },
    "projectId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
  }
}
