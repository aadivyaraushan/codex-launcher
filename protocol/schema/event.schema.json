{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-launcher.local/schema/event.schema.json",
  "title": "Codex Launcher companion event body",
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!.*[\\r\\n])[A-Za-z0-9._:-]+$" },
    "projectId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName"],
      "properties": {
        "id": { "$ref": "#/$defs/projectId" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!\\s*$)(?!.*[\\u0000-\\u001F\\u007F-\\u009F])[\\s\\S]+$" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "title", "projectLabel", "state", "lastActivityAt"],
      "properties": {
        "taskId": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!\\s*$)(?!.*[\\u0000-\\u001F\\u007F-\\u009F])[\\s\\S]+$" },
        "projectLabel": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!\\s*$)(?!.*[\\u0000-\\u001F\\u007F-\\u009F])[\\s\\S]+$" },
        "state": { "enum": ["working", "waiting_for_approval", "waiting_for_answer", "failed", "interrupted", "idle_after_reply"] },
        "lastActivityAt": { "type": "string", "format": "date-time" },
        "pendingRequest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestId", "kind", "summary"],
          "properties": {
            "requestId": { "$ref": "#/$defs/id" },
            "kind": { "enum": ["command", "file", "permissions", "question", "mcp_elicitation"] },
            "summary": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!\\s*$)(?!.*[\\u0000-\\u001F\\u007F-\\u009F])[\\s\\S]+$" }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "retryable"],
      "properties": {
        "code": { "enum": ["computer_offline", "connection_lost", "desktop_incompatible", "owner_unavailable", "invalid_action", "outcome_unknown", "sequence_gap", "unauthorized", "quota_exceeded", "attachment_invalid", "internal"] },
        "retryable": { "type": "boolean" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseSeq", "computerName", "projects", "tasks"],
      "properties": {
        "baseSeq": { "type": "integer", "minimum": 1 },
        "computerName": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^(?!\\s*$)(?!.*[\\u0000-\\u001F\\u007F-\\u009F])[\\s\\S]+$" },
        "projects": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/project" } },
        "tasks": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/task" } }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "event", "state", "summary"],
      "properties": {
        "taskId": { "$ref": "#/$defs/id" },
        "event": { "enum": ["activity", "reply", "approval", "answer", "failure", "interrupted", "metadata"] },
        "state": { "enum": ["working", "waiting_for_approval", "waiting_for_answer", "failed", "interrupted", "idle_after_reply"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!\\s*$)(?!.*[\\u0000-\\u001F\\u007F-\\u009F])[\\s\\S]+$" }
      }
    },
    "actionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "state"],
      "properties": {
        "actionId": { "$ref": "#/$defs/id" },
        "state": { "enum": ["queued", "sent", "confirmed", "outcome_unknown", "failed", "cancelled"] },
        "error": { "$ref": "#/$defs/error" }
      },
      "allOf": [{ "if": { "properties": { "state": { "enum": ["failed", "outcome_unknown"] } } }, "then": { "required": ["error"] } }]
    },
    "decisionPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "taskId", "requests"],
      "properties": {
        "requestId": { "$ref": "#/$defs/id" },
        "taskId": { "$ref": "#/$defs/id" },
        "requests": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/decisionRequest" } }
      }
    },
    "decisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "turnId", "itemId", "kind", "computerName", "projectLabel", "expiresAt"],
      "properties": {
        "requestId": { "$ref": "#/$defs/id" },
        "turnId": { "$ref": "#/$defs/id" },
        "itemId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["command", "file", "permissions", "question", "mcp_elicitation"] },
        "computerName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "projectLabel": { "type": "string", "minLength": 1, "maxLength": 128 },
        "workingDirectory": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "access": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "command": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "commandUnderstandable": { "type": "boolean" },
        "affectedPaths": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
        "allowedDecisions": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["accept", "accept_for_session", "decline", "cancel"] } },
        "questions": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/decisionQuestion" } },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "mcp_elicitation" } }, "required": ["kind"] },
          "then": {
            "required": ["allowedDecisions"],
            "properties": {
              "allowedDecisions": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["decline", "cancel"] } }
            }
          }
        }
      ]
    },
    "decisionQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "header", "prompt", "options", "secret"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "header": { "type": "string", "minLength": 1, "maxLength": 128 },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "options": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "secret": { "type": "boolean" }
      }
    }
  }
}
